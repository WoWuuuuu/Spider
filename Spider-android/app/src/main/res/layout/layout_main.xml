<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚠ 这里原来是 `DrawerLayout` + 两个 `NavigationView`（普通主题一个、黑主题一个，
  运行时按主题 `removeView` 掉不用的那个）。2026-09-16 用户拍板**整个删掉**：

  · 新主页（TopologyFragment）把左侧抽屉换成了右侧滑入的设置面板，抽屉不再承担导航；
  · 抽屉其实早就死了 —— `MainActivity` 里 `setDrawerLockMode(LOCK_MODE_LOCKED_CLOSED)`，
    手势和 `openDrawer()` 都打不开，`TopologyFragment` 还显式把汉堡图标设成 null；
  · 结果只剩「其它页顶栏上有个点了没反应的汉堡」这一个副作用。

  删掉之后根布局直接是 `CoordinatorLayout`（id 仍是 `coordinator`）。
  `tools:openDrawer` 是抽屉专用的预览属性，跟着一起删。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/fragment_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
